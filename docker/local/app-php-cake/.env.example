# APP名
APP_NAME=app-php-cake

# サーバー名
SERVER_NAME=apis.showcase-php-cake.dev

# Nginx
NGINX_CONTAINER=showcase-php-cake_nginx
NGINX_HTTP_PORT=80
FASTCGI_PATH=showcase-php-cake_php:9030

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Let's Encrypt
LETSENCRYPT_EMAIL=

# PHP
PHP_CONTAINER=showcase-php-cake_php
PHP_XDEBUG_PORT=19003

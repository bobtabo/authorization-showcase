# APP名
APP_NAME=app-java

# サーバー名
SERVER_NAME=apis.showcase-java-spring.dev

# Nginx
NGINX_CONTAINER=showcase-java-spring_nginx
NGINX_HTTP_PORT=80
APP_PATH=java:8080

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Let's Encrypt
LETSENCRYPT_EMAIL=

# Java（Spring Boot）
JAVA_CONTAINER=showcase-java-spring_java
JAVA_DEBUG_PORT=15005

# APP名
APP_NAME=app-php-codeigniter

# サーバー名
SERVER_NAME=apis.showcase-php-codeigniter.dev

# Nginx
NGINX_CONTAINER=showcase-php-codeigniter_nginx
NGINX_HTTP_PORT=80
FASTCGI_PATH=showcase-php-codeigniter_php:9030

# Let's Encrypt
LETSENCRYPT_EMAIL=

# PHP
PHP_CONTAINER=showcase-php-codeigniter_php
PHP_XDEBUG_PORT=19004
